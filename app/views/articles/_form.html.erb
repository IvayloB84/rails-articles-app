<%= form_with model: article, html: { multipart: true, class: "space-y-6" } do |form| %>

<% if article.errors.any? %>
  <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6 shadow-sm">
    <h2 class="text-sm font-bold text-red-800 mb-1">
     <%= pluralize(article.errors.count, "error") %> blocked this article from being saved:
    </h2>
    <ul class="list-disc list-inside text-xs text-red-700 space-y-0.5">
      <% article.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

  <% if article.user_id == Current.user&.id || Current.user&.admin? || article.new_record? %>
    <!-- Title Input -->
    <div class="mb-6">
      <%= form.label :title, "Article Title", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :title, class: "block w-full rounded-lg border border-gray-300 p-2.5 bg-white text-gray-900 focus:border-blue-500 focus:ring-blue-500 text-sm shadow-sm" %>
    </div>

    <!-- Body Input -->
    <div class="mb-6">
      <%= form.label :body, "Article Body", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :body, rows: 6, class: "block w-full rounded-lg border border-gray-300 p-2.5 bg-white text-gray-900 focus:border-blue-500 focus:ring-blue-500 text-sm shadow-sm" %>
    </div>
  <% else %>
    <div class="p-4 mb-6 text-sm text-blue-800 rounded-lg bg-blue-50 font-medium">
      💡 You are editing this article as an Administrator. You retain full control over the header media attachment layers below.
    </div>
  <% end %>

  <!-- IMAGE GALLERY MEDIA MANAGEMENT LAYER -->
  <div class="mb-6 bg-gray-50 border border-gray-200 rounded-xl p-4">
    <%= form.label :images, "Gallery Photos", class: "block text-sm font-bold text-gray-700 mb-2" %>
    
    <% if article.images.attached? %>
      <!-- 📸 Visual verification grid list of all currently attached images -->
      <p class="text-xs font-semibold text-gray-500 mb-2">Current gallery files attached (check box to remove):</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <% article.images.each do |img| %>
          <% if img.persisted? %>
            <div class="flex items-center gap-3 bg-white p-2.5 border border-gray-200 rounded-lg shadow-sm">
              <%= image_tag img, class: "rounded-md border border-gray-100 object-cover h-12 w-12 shrink-0 bg-gray-50" %>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-medium text-gray-700 truncate mb-1"><%= img.filename.to_s %></p>
                
                <!-- 🗑️ Checkbox maps to your controller's purge_image_ids parameter matrix -->
                <label class="inline-flex items-center text-xs text-red-600 font-semibold hover:text-red-800 cursor-pointer select-none">
                  <%= check_box_tag "article[purge_image_ids][]", img.id, false, id: "purge_img_#{img.id}", class: "rounded border-gray-300 text-red-600 focus:ring-red-500 mr-1.5 h-3.5 w-3.5 cursor-pointer" %>
                  Remove
                </label>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- File Input to upload fresh pictures into the array -->
    <p class="text-xs text-gray-500 mb-2 font-medium">Choose image files to add to this article gallery:</p>
    <%= form.file_field :images, multiple: true, include_hidden: false, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-gray-300 rounded-lg p-2 bg-white cursor-pointer" %>
  </div>

  <%= form.submit (article.new_record? ? "Publish Article" : "Update Article"), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-5 rounded-lg text-sm cursor-pointer shadow-sm w-full transition text-center block" %>
<% end %>