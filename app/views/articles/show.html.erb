<%# app/views/articles/show.html.erb %>
<div class="max-w-3xl mx-auto px-4 py-8">
  <!-- Navigation Top Bar -->
  <div class="mb-6">
    <%= link_to "← Back to Articles Feed", articles_path, class: "text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors" %>
  </div>

  <!-- Render cover photo banner elegantly at the top of the content stack -->
  <% if @article.images.attached? %>
    <!-- Dynamic Gallery Carousel Slider -->
    <div class="w-full bg-gray-900 rounded-xl overflow-hidden mb-6 border border-gray-200 shadow-lg relative group h-96">
      <div class="flex h-full overflow-x-scroll snap-x snap-mandatory scroll-smooth hide-scrollbar" id="carousel-viewport">
        <% @article.images.each_with_index do |image, index| %>
          <div id="slide-<%= index %>" class="w-full h-full flex-shrink-0 snap-start relative flex justify-center items-center bg-black/10">
            
            <%= link_to "#lightbox-#{index}", class: "w-full h-full flex justify-center items-center cursor-zoom-in" do %>
              <%= image_tag image, class: "max-w-full max-h-full object-contain" %>
            <% end %>

            <div class="absolute inset-x-4 top-1/2 -translate-y-1/2 flex justify-between pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity">
              <% if index > 0 %>
                <a href="#slide-<%= index - 1 %>" class="pointer-events-auto p-2 rounded-full bg-black/60 hover:bg-black text-white text-xs font-bold transition">◀ Prev</a>
              <% else %>
                <span></span>
              <% end %>
              <% if index < @article.images.count - 1 %>
                <a href="#slide-<%= index + 1 %>" class="pointer-events-auto p-2 rounded-full bg-black/60 hover:bg-black text-white text-xs font-bold transition">Next ▶</a>
              <% end %>
            </div>

            <span class="absolute bottom-4 right-4 px-2 py-1 rounded bg-black/60 text-[10px] text-white font-medium">
              <%= index + 1 %> / <%= @article.images.count %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <% @article.images.each_with_index do |image, index| %>
      <div id="lightbox-<%= index %>" class="hidden target:flex fixed inset-0 bg-black/95 z-50 justify-center items-center p-4 animate-fade-in backdrop-blur-sm group/lightbox">
        <a href="#" class="absolute inset-0 cursor-zoom-out" title="Close Lightbox"></a>
        <% if index > 0 %>
          <a href="#lightbox-<%= index - 1 %>" class="absolute left-6 text-white/50 hover:text-white text-4xl font-extrabold bg-white/5 hover:bg-white/10 p-5 rounded-full transition-all duration-200 z-50 select-none shadow-md border border-white/5">◀</a>
        <% end %>
        <div class="relative max-w-5xl max-h-[90vh] flex justify-center items-center z-10">
          <%= image_tag image, class: "max-w-full max-h-[85vh] object-contain rounded-md shadow-2xl border border-white/10" %>
          <a href="#" class="absolute -top-12 right-0 text-white hover:text-gray-300 font-bold text-xs bg-white/10 px-3 py-1.5 rounded-md transition border border-white/10 shadow-sm">✕ Close View</a>
        </div>
        <% if index < @article.images.count - 1 %>
          <a href="#lightbox-<%= index + 1 %>" class="absolute right-6 text-white/50 hover:text-white text-4xl font-extrabold bg-white/5 hover:bg-white/10 p-5 rounded-full transition-all duration-200 z-50 select-none shadow-md border border-white/5">▶</a>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <!-- Main Article Body Container Wrapper -->
  <article class="bg-white shadow rounded-lg border border-gray-200 p-6 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 pb-4 border-b border-gray-100 gap-4">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight"><%= @article.title %></h1>
      
      <!-- ARTICLE ACTION LINKS -->
      <div class="flex items-center text-sm font-semibold shrink-0">
        <% if authenticated? %>
          <div class="flex items-center space-x-3">
            <% if @article.user_id == Current.user.id || Current.user.admin? %>
              <%= link_to "Edit Article", edit_article_path(@article), class: "text-blue-600 hover:text-blue-800 transition-colors" %>
            <% end %>
            
            <% if Current.user.admin? %>
              <span class="text-gray-300">|</span>
              <%= button_to "Delete Article", article_path(@article), method: :delete, form: { onclick: "return confirm('Delete this article permanently?');" }, class: "text-red-500 hover:text-red-700 hover:underline cursor-pointer bg-transparent border-0 p-0 inline" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Article Main Text Body Field -->
    <div class="prose max-w-none text-gray-700 text-lg leading-relaxed whitespace-pre-wrap mb-4">
      <%= @article.body %>
    </div>
  </article>

  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <!-- RATINGS BADGE -->
    <div class="inline-flex items-center bg-amber-50 border border-amber-200 rounded-full px-3 py-1 text-sm text-gray-700 shadow-sm">
      <span class="text-amber-400 font-bold mr-1.5">
        <% average = @article.ratings.average(:score).to_f.round(1) %>
        <% if average > 0 %>
          <% average.to_i.times do %>★<% end %><% (5 - average.to_i).times do %>☆<% end %>
        <% else %>
          ☆☆☆☆☆
        <% end %>
      </span>
      <span class="font-bold text-xs text-gray-800 mr-2"><%= average > 0 ? average : "0.0" %> (<%= @article.ratings.count %>)</span>

      <% if authenticated? %>
        <% existing_rating = @article.ratings.find_by(user_id: Current.user.id) %>
        <% if existing_rating %>
          <div class="flex items-center gap-1.5 border-l border-amber-200 pl-2 ml-1 text-xs">
            <span class="text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full font-bold">✓ My Rating: <%= existing_rating.score %>★</span>
            <%= button_to "Remove", article_rating_path(@article, existing_rating), method: :delete, class: "text-red-500 hover:text-red-700 font-bold transition hover:underline cursor-pointer bg-transparent border-0 p-0 text-xs ml-1" %>
          </div>
        <% else %>
          <%= form_with model: [@article, @article.ratings.build], class: "flex items-center gap-1 border-l border-amber-200 pl-2 ml-1" do |form| %>
            <div class="flex flex-row-reverse items-center gap-0.5">
              <% 5.downto(1) do |num| %>
                <%= form.radio_button :score, num, id: "star_#{num}", class: "hidden peer", checked: num == 5 %>
                <label for="star_<%= num %>" class="text-base text-gray-300 peer-hover:text-amber-400 peer-checked:text-amber-400 hover:text-amber-400 cursor-pointer transition-colors px-0.5">★</label>
              <% end %>
            </div>
            <%= form.submit "Rate", class: "ml-2 bg-amber-500 hover:bg-amber-600 text-white font-bold text-[10px] px-2 py-0.5 rounded transition cursor-pointer" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <hr class="border-t border-gray-200 my-8">

  <% if flash[:alert] %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6 shadow-sm">
      <div class="flex">
        <p class="text-sm text-red-700"><%= flash[:alert] %></p>
      </div>
    </div>
  <% end %>
  <!-- COMMENTS LIST WRAPPER -->
  <div class="space-y-6 mb-8">
    <h2 class="text-xl font-bold text-gray-900">Comments (<%= @total_comments %>)</h2>
    
    <% if @comments.any? %>
      <div class="space-y-4">
        <% @comments.each do |comment| %>
          <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm relative group">
            <div class="flex items-start justify-between">
              <div>
                <span class="inline-block text-sm font-semibold text-gray-900"><%= comment.commenter %></span>
                <% if comment.status == "pending" %>
                  <span class="ml-2 inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">Pending Admin Review</span>
                <% end %>
                <p class="text-gray-600 text-sm mt-1 leading-relaxed"><%= comment.body %></p>
                <span class="block text-[11px] text-gray-400 mt-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
              </div>

              <%# 🔒 FULL ADMIN SUPER RIGHTS: Admins see and use this delete control on every comment %>
              <% if authenticated? && Current.user.admin? %>
                <div>
                  <%= button_to "Delete Comment", article_comment_path(@article, comment), method: :delete, form: { onclick: "return confirm('Delete this comment permanently?');" }, class: "text-xs text-red-500 hover:text-red-700 font-semibold cursor-pointer bg-transparent border-0 p-0 hover:underline inline" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @total_pages > 1 %>
        <div class="flex justify-center items-center space-x-2 mt-6">
          <%= link_to_if @page > 1, "◀ Previous", article_path(@article, page: @page - 1), class: "px-3 py-1.5 border border-gray-300 rounded-md text-xs font-medium text-gray-700 bg-white hover:bg-gray-50" %>
          <span class="text-xs text-gray-500 font-medium">Page <%= @page %> of <%= @total_pages %></span>
          <%= link_to_if @page < @total_pages, "Next ▶", article_path(@article, page: @page + 1), class: "px-3 py-1.5 border border-gray-300 rounded-md text-xs font-medium text-gray-700 bg-white hover:bg-gray-50" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-500 italic bg-gray-50 rounded-xl p-6 text-center border border-dashed border-gray-200">No comments found matching your verification filters.</p>
    <% end %>
  </div>

  <% if authenticated? %>
    <div class="bg-gray-50 rounded-lg border border-gray-200 p-6">
      
      <% if Current.user.admin? %>
        <h3 class="text-lg font-bold text-blue-900 mb-1">🛡️ Administrative Commentary Workspace</h3>
        <p class="text-xs text-blue-700 mb-4 italic">You are logged in as an Administrator. Your comments will bypass the queue and publish instantly.</p>
      <% else %>
        <h3 class="text-lg font-bold text-gray-900 mb-1">Leave a Comment</h3>
        <p class="text-xs text-amber-600 mb-4 italic">💬 Note: Your comment will be held as pending for administrative verification before being published.</p>
      <% end %>

      <%= form_with model: [ @article, Comment.new ], html: { class: "space-y-4" } do |form| %>
        <div>
          <%= form.label :commenter, "Your Username", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :commenter, value: Current.user.username, readonly: true, class: "block w-full max-w-md rounded-md border border-gray-300 shadow-sm p-2 bg-gray-100 text-gray-500 text-sm focus:outline-none cursor-not-allowed" %>
        </div>
        <div>
          <%= form.label :body, "Comment Text", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :body, rows: 4, placeholder: "Type your comment here...", class: "block w-full max-w-xl rounded-md border border-gray-300 shadow-sm p-2 bg-white text-gray-900 focus:border-blue-500 focus:ring-blue-500 text-sm" %>
        </div>
        <%= form.submit "Post Comment", class: "inline-flex items-center px-4 py-2 text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 cursor-pointer transition-colors" %>
      <% end %>
      
    </div>
  <% else %>
    <div class="bg-gray-50 border border-gray-200 p-6 rounded-lg text-center shadow-sm">
      <p class="text-base font-semibold text-gray-800">Want to join the conversation?</p>
      <p class="text-xs text-gray-500 mt-1 max-w-md mx-auto">Only registered members can submit comments. All submissions undergo administrative moderation verification before publishing.</p>
      <%= link_to 'Sign In to Comment', new_session_path, class: "bg-blue-600 text-white text-xs font-semibold px-4 py-2 rounded-md hover:bg-blue-700 mt-4 inline-block shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>
