<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Profile Header Card Layout Container -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex items-center space-x-4">
      <div class="h-16 w-16 rounded-full bg-blue-600 flex items-center justify-center text-white text-2xl font-extrabold shadow-inner shrink-0">
        <%= @user.username[0..1].upcase %>
      </div>
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">👤 <%= @user.username %></h1>
        <p class="text-sm text-gray-500 mt-0.5">Member since <%= @user.created_at.strftime("%B %Y") %></p>
        
        <% if @user.admin? %>
          <span class="mt-2 inline-flex items-center rounded-md bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700 ring-1 ring-inset ring-blue-700/10">👑 System Administrator</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Dedicated Biography Panel Display Box -->
  <% if @user.bio.present? %>
    <div class="bg-blue-50/40 border border-blue-100 rounded-xl p-5 mb-8 shadow-sm relative group">
      <div class="flex justify-between items-start mb-1">
        <h3 class="text-xs font-bold text-blue-800 uppercase tracking-wider">Biography</h3>
        
        <!-- Edit/Delete Action visible ONLY to the true Owner OR an Admin -->
        <% if authenticated? && (Current.user == @user || Current.user.admin?) %>
          <div class="shrink-0">
            <a href="#bio-edit-mode" id="bio-edit-btn" class="inline-flex items-center text-xs font-medium text-blue-600 hover:text-blue-800 hover:underline cursor-pointer">
              ✏️ Edit Bio
            </a>
          </div>
        <% end %>
      </div>
      <p class="text-gray-700 text-sm leading-relaxed italic">"<%= @user.bio %>"</p>

      <!-- Inline Hidden Edit Box Form -->
      <% if authenticated? && (Current.user == @user || Current.user.admin?) %>
        <div id="bio-edit-mode" class="hidden target:block mt-4 pt-4 border-t border-blue-100">
          <%= form_with model: @user, url: user_path(@user.username), method: :patch, class: "flex flex-col sm:flex-row gap-2 items-end sm:items-center" do |form| %>
            <div class="w-full sm:flex-1">
              <%= form.text_field :bio, class: "block w-full rounded-md border border-gray-300 shadow-sm p-2 bg-white text-gray-900 text-xs focus:border-blue-500 focus:ring-blue-500" %>
            </div>
            <div class="flex gap-1 shrink-0">
              <%= form.submit "Update Bio", class: "px-2.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded shadow-sm transition-colors cursor-pointer" %>
              <a href="#" class="px-2.5 py-2 bg-white border border-gray-200 hover:bg-gray-50 text-gray-500 font-semibold text-xs rounded shadow-sm transition-colors text-center text-xs">Cancel</a>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% elsif authenticated? && (Current.user == @user || Current.user.admin?) %>
    <!-- Fallback Empty State: Prompt box to add biography if none exists yet -->
    <div class="bg-gray-50 border border-gray-200 border-dashed rounded-xl p-6 mb-8 text-center">
      <p class="text-sm text-gray-500 mb-3">No biography has been added to this profile yet.</p>
      <%= form_with model: @user, url: user_path(@user.username), method: :patch, class: "max-w-md mx-auto flex gap-2" do |form| %>
        <%= form.text_field :bio, placeholder: "Type biography here...", class: "block w-full rounded-md border border-gray-300 shadow-sm p-2 bg-white text-gray-900 text-xs focus:border-blue-500 focus:ring-blue-500" %>
        <%= form.submit "Add Bio", class: "px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded shadow-sm transition-colors cursor-pointer shrink-0" %>
      <% end %>
    </div>
  <% end %>

  <!-- Dual Split Column Dashboard Metrics Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Left Column: User Articles Feed -->
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-2">Published Articles (<%= @articles.count %>)</h3>
      <% if @articles.any? %>
        <div class="space-y-3">
          <% @articles.each do |article| %>
            <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition shadow-sm">
              <%= link_to article.title, article_path(article), class: "text-lg font-bold text-blue-600 hover:underline block truncate" %>
              <span class="text-xs text-gray-400 block mt-1">Posted on <%= article.created_at.strftime("%b %d, %Y") %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-400 italic py-2 text-sm">This user hasn't published any articles yet.</p>
      <% end %>
    </div>

    <!-- Right Column: User Comments Activity Logs -->
    <div class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-2">Approved Comments (<%= @comments.count %>)</h3>
      <% if @comments.any? %>
        <div class="space-y-3">
          <% @comments.each do |comment| %>
            <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
              <p class="text-gray-700 text-sm italic mb-2">"<%= truncate(comment.body, length: 80) %>"</p>
              <div class="text-xs text-gray-400">
                Left under: <%= link_to comment.article.title, article_path(comment.article), class: "text-blue-500 hover:underline font-medium" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-400 italic py-2 text-sm">This user hasn't posted any approved comments yet.</p>
      <% end %>
    </div>
  </div>
</div>